generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique // F5-YYYYMMDD-XXXX
  
  customerName  String
  phone         String
  address       String      // Full address string
  note          String?
  
  paymentMethod String      // cash_door | card_door | online
  status        String      @default("new") // new, preparing, delivered, cancelled
  
  total         Float
  createdAt     DateTime    @default(now())
  
  items         OrderItem[]
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  
  productName String
  quantity    Int
  price       Float
  extras      String   // Stored as JSON string or comma-separated
  totalPrice  Float
}
